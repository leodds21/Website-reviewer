# Copy to .env.local. None of these is needed to run the app locally:
# each one only turns on a part that otherwise degrades on its own.

# Google PageSpeed Insights API key (free, from Google Cloud).
# Without it, the Google-measured parts of a report (performance, and
# Google's share of SEO/accessibility/best practices) show as "not measured".
PAGESPEED_API_KEY=

# Formspree form endpoint for the contact form, e.g. https://formspree.io/f/<form-id>.
# Not a secret: the browser posts to it directly. Without it, the form
# says it isn't configured.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# Absolute site URL for metadata, robots.txt and the sitemap.
# Defaults to https://scan.lsdias.dev; set it on preview/staging deploys.
NEXT_PUBLIC_SITE_URL=

# Upstash Redis (REST) for the analysis cache and the per-IP rate limit.
# Without both, they fall back to an in-memory Map: fine locally, but
# reset on every restart and not shared between serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
