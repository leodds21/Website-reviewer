# Copy to .env.local. All optional for local development.

# Google PageSpeed Insights API key. Without it, Google's scores show as "not measured".
PAGESPEED_API_KEY=

# Formspree endpoint for the contact form, e.g. https://formspree.io/f/<form-id>.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# Site URL for metadata. Defaults to https://scan.lsdias.dev.
NEXT_PUBLIC_SITE_URL=

# Upstash Redis for the cache and rate limit. Without it, both are in memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
