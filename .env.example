PAGESPEED_API_KEY=
# Formspree form endpoint (not a secret — it's the public POST target
# used from the client, same as embedding it in plain HTML).
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# Optional. Without these, the analysis cache and the per-IP rate
# limit fall back to an in-memory Map — fine for local dev, but reset
# on every deploy/cold start and not shared across concurrent
# serverless instances in production. Set both (a free Upstash
# database is enough) for the real, shared behavior. See lib/kv.ts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
